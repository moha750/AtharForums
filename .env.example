# ── Supabase ────────────────────────────────────────────────────────────────
# لوحة Supabase ← Project Settings ← API Keys
# المفتاح أدناه عام بطبيعته وآمن في المتصفّح ما دامت سياسات RLS مفعّلة.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# ── الموقع ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── إحصاءات الزوار ──────────────────────────────────────────────────────────
# مفتاح سرّي يمنع حقن زيارات مزوّرة. يجب أن يطابق الصفّ في
# public.analytics_ingest_key، وألّا يقلّ عن ٢٤ حرفًا.
# بدونه يتعطّل التسجيل بصمت — وهذا مقصود: البيئة المحلّية لا تلوّث الأرقام.
#   توليد مفتاح: openssl rand -base64 36
# ANALYTICS_INGEST_KEY=".."

# ── الباركود الديناميكي ─────────────────────────────────────────────────────
# أصل الرابط القصير المطبوع داخل كل باركود: {QR_ORIGIN}/q/{code}
# ثبّته على النطاق النهائي قبل طباعة أي ملصق — تغييره بعدها يكسر كل ما طُبع.
# بدونه يُستعمل NEXT_PUBLIC_SITE_URL (مقبول في التطوير فقط).
# QR_ORIGIN="https://athar.example.sa"
#
# سرّ باب المسح: يطابق الصفّ في public.qr_server_key، ولا يقلّ عن ٣٢ حرفًا.
# بدونه يذهب كل مسح إلى «غير متاح». توليده: openssl rand -base64 36
# QR_SERVER_KEY=".."
#
# ملح بصمة الماسح (sha256 لـ IP + الملح + اليوم). بدونه في الإنتاج لا تُحسب
# بصمة، فلا يُمنع تكرار المسح خلال دقيقة — والتحويل يعمل.
# QR_VISITOR_SALT=".."
#
# تنبيه تبديل الوجهة لحاملي oversee_qr — مطفأ افتراضيًّا.
# QR_ALERTS="on"
# SMTP_URL="smtps://user:pass@smtp.example.sa:465"
# QR_ALERTS_FROM="مساحة أثر <no-reply@hrsd.gov.sa>"
# سرّ نقطة الاستنزاف /api/qr/alerts/drain (Authorization: Bearer …)، ٢٤ حرفًا فأكثر
# QR_CRON_SECRET=".."

# ملاحظة أمنية مقصودة: هذا المشروع لا يستخدم مفتاح service_role إطلاقًا.
# كل العمليات — بما فيها لوحة التحكم — تمرّ عبر جلسة المستخدم وسياسات RLS،
# فلا يوجد مفتاح يتجاوز الأمان يمكن أن يتسرّب.

# ── المعاينة بلا قاعدة بيانات (للتطوير فقط) ─────────────────────────────────
# ATHAR_PREVIEW_FIXTURES=1   يعرض الموقع كاملًا ببيانات تجريبية بلا Supabase
# ATHAR_PREVIEW_TEASER=1     يُجبر الوضع التشويقي داخل المعاينة
# ATHAR_PREVIEW_ANON=1       يعامل الزائر كغير مسجَّل داخل المعاينة
