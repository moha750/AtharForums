# ── Supabase ────────────────────────────────────────────────────────────────
# لوحة Supabase ← Project Settings ← API Keys
# المفتاح أدناه عام بطبيعته وآمن في المتصفّح ما دامت سياسات RLS مفعّلة.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# ── الموقع ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ملاحظة أمنية مقصودة: هذا المشروع لا يستخدم مفتاح service_role إطلاقًا.
# كل العمليات — بما فيها لوحة التحكم — تمرّ عبر جلسة المستخدم وسياسات RLS،
# فلا يوجد مفتاح يتجاوز الأمان يمكن أن يتسرّب.

# ── المعاينة بلا قاعدة بيانات (للتطوير فقط) ─────────────────────────────────
# ATHAR_PREVIEW_FIXTURES=1   يعرض الموقع كاملًا ببيانات تجريبية بلا Supabase
# ATHAR_PREVIEW_TEASER=1     يُجبر الوضع التشويقي داخل المعاينة
# ATHAR_PREVIEW_ANON=1       يعامل الزائر كغير مسجَّل داخل المعاينة
